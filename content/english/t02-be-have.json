    { "type": "choice", "task": "Welche Form von to be?", "q": "we ___", "options": ["are", "is", "am"], "answer": "are", "explain": "**we are**." },
    { "type": "choice", "task": "Welche Form von to be?", "q": "they ___", "options": ["are", "is", "am"], "answer": "are", "explain": "**they are**." },
    { "type": "choice", "task": "Welche Form von to have?", "q": "I ___", "options": ["have", "has"], "answer": "have", "explain": "**I have**. has nur bei he, she, it." },
