    { "type": "choice", "q": "Listen! Mum ___.", "options": ["is singing", "sings", "are singing", "sing"], "answer": "is singing" },
    { "type": "choice", "q": "Which -ing form is correct? (swim)", "options": ["swimming", "swiming", "swimeing", "swimmming"], "answer": "swimming", "speak": false, "explain": "Kurzer Vokal + ein Konsonant → verdoppeln: swi**mm**ing." },
    { "type": "choice", "q": "Which -ing form is correct? (write)", "options": ["writing", "writeing", "writting", "writes"], "answer": "writing", "speak": false, "explain": "Stummes -e fällt weg: writ**ing**." },
    { "type": "choice", "q": "Which -ing form is correct? (play)", "options": ["playing", "plaing", "playying", "plaiing"], "answer": "playing", "speak": false },
