    { "type": "input", "q": "They ___ in my class.", "answer": "are", "hint": "am / is / are", "explain": "they → **are**." },
    { "type": "input", "q": "The pencils ___ on the desk.", "answer": "are", "hint": "am / is / are", "explain": "The pencils = mehrere = they → **are**." },
    { "type": "input", "q": "My mum ___ a teacher.", "answer": "is", "hint": "am / is / are", "explain": "My mum = she → **is**." },
    { "type": "input", "q": "We ___ hungry.", "answer": "are", "hint": "am / is / are", "explain": "we → **are**." },
    { "type": "choice", "task": "Welche Kurzform ist richtig?", "q": "I am happy. → ___ happy.", "options": ["I'm", "I's", "Im'", "I're"], "answer": "I'm", "speak": false, "explain": "I am → **I'm**. Der Apostroph **'** steht da, wo das „a“ weggefallen ist." },
    { "type": "choice", "task": "Welche Kurzform ist richtig?", "q": "They are late. → ___ late.", "options": ["They're", "Their", "They's", "There"], "answer": "They're", "speak": false, "explain": "they are → **they're**. Achtung: **their** (ihr/ihre) und **there** (dort) sind andere Wörter!" },
    { "type": "choice", "task": "Welche Kurzform ist richtig?", "q": "She is nice. → ___ nice.", "options": ["She's", "Shes'", "She're", "She'm"], "answer": "She's", "speak": false, "explain": "She is → **She's**. Der Apostroph **'** steht da, wo das „i“ weggefallen ist." },
    { "type": "order", "de": "Ich bin elf Jahre alt.", "answer": "I am eleven years old.", "accept": ["I'm eleven years old."], "explain": "Im Englischen „ist“ man so alt: **I am** eleven years old. (nicht: I have …)" },
    { "type": "order", "de": "Sie sind meine Freunde.", "answer": "They are my friends.", "explain": "**They are** = sie sind. Dann kommt „my friends“." },
