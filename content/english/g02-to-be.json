{
  "id": "to-be",
  "line": "ichbin",
  "order": 2,
  "title": "am, is, are",
  "subtitle": "Das Verb „sein“",
  "icon": "🟰",
  "explain": [
    { "p": "„sein“ heißt auf Englisch **to be**. Es hat drei Formen: **am**, **is** und **are**." },
    { "table": { "head": ["Langform", "Kurzform", "Deutsch"], "rows": [
      ["I **am**", "I'm", "ich bin"],
      ["you **are**", "you're", "du bist"],
      ["he / she / it **is**", "he's / she's / it's", "er / sie / es ist"],
      ["we **are**", "we're", "wir sind"],
      ["you **are**", "you're", "ihr seid"],
      ["they **are**", "they're", "sie sind"]
    ] } },
    { "tip": "Merksatz: **I → am**. **He, she, it → is**. **Alle anderen → are**." },
    { "p": "Für ein Ding, eine Person oder ein Tier steht **is**, für mehrere **are**:" },
    { "ex": [["My dog is black.", "Mein Hund ist schwarz."], ["My dogs are black.", "Meine Hunde sind schwarz."]] }
  ],
  "exercises": [
    { "type": "choice", "q": "I ___ ten years old.", "options": ["am", "is", "are"], "answer": "am", "explain": "Nach **I** kommt immer **am**." },
    { "type": "choice", "q": "She ___ my best friend.", "options": ["is", "am", "are"], "answer": "is", "explain": "he, she, it → **is**." },
    { "type": "choice", "q": "We ___ in the garden.", "options": ["are", "is", "am"], "answer": "are", "explain": "we → **are**." },
    { "type": "choice", "q": "My cat ___ very old.", "options": ["is", "are", "am"], "answer": "is", "explain": "My cat = it → **is**." },
    { "type": "choice", "q": "Tom and Ben ___ brothers.", "options": ["are", "is", "am"], "answer": "are", "explain": "Tom und Ben = they → **are**." },
    { "type": "choice", "q": "You ___ very funny!", "options": ["are", "is", "am"], "answer": "are", "explain": "you → **are**." },
    { "type": "choice", "q": "It ___ cold today.", "options": ["is", "are", "am"], "answer": "is", "explain": "it → **is**. (am nur bei I, are bei you/we/they)" },
    { "type": "choice", "q": "My parents ___ at work.", "options": ["are", "is", "am"], "answer": "are", "explain": "My parents = they → **are**." },
    { "type": "input", "q": "I ___ from Germany.", "answer": "am", "hint": "am / is / are", "explain": "I → immer **am**." },
