{
  "id": "have-got",
  "line": "meins",
  "order": 1,
  "title": "have got / has got",
  "subtitle": "Etwas haben / besitzen",
  "icon": "🎁",
  "explain": [
    { "p": "Wenn du sagen willst, dass jemand etwas **hat** (besitzt), benutzt du **have got** oder **has got**." },
    { "table": { "head": ["Wer?", "Form", "Kurzform"], "rows": [
      ["I, you, we, they", "**have got**", "I've got, you've got, we've got, they've got"],
      ["he, she, it", "**has got**", "he's got, she's got, it's got"]
    ] } },
    { "tip": "Wie beim -s: **he, she, it → has**. Alle anderen → have." },
    { "p": "**Verneinung:** haven't got / hasn't got — **Frage:** Have you got …? / Has she got …?" },
    { "ex": [["I've got a brother.", "Ich habe einen Bruder."], ["She hasn't got a pet.", "Sie hat kein Haustier."], ["Have you got a pencil? – Yes, I have. / No, I haven't.", "Hast du einen Bleistift? – Ja. / Nein."]] }
  ],
  "exercises": [
    { "type": "choice", "q": "I ___ got a cat.", "options": ["have", "has"], "answer": "have", "explain": "I → **have** got. has nur bei he, she, it." },
    { "type": "choice", "q": "She ___ got long hair.", "options": ["has", "have"], "answer": "has", "explain": "he, she, it → **has** got." },
    { "type": "choice", "q": "We ___ got a big garden.", "options": ["have", "has"], "answer": "have", "explain": "we → **have** got." },
    { "type": "choice", "q": "My brother ___ got a new phone.", "options": ["has", "have"], "answer": "has", "explain": "My brother = he → **has** got." },
    { "type": "choice", "q": "The dog ___ got a ball.", "options": ["has", "have"], "answer": "has", "explain": "The dog = it → **has** got." },
    { "type": "choice", "q": "Tom and Lisa ___ got bikes.", "options": ["have", "has"], "answer": "have", "explain": "Tom and Lisa = they → **have** got." },
    { "type": "choice", "q": "He ___ got a sister.", "de": "Er hat keine Schwester.", "options": ["hasn't", "haven't", "isn't", "don't"], "answer": "hasn't", "explain": "he → has → verneint **hasn't** got (= has not got)." },
    { "type": "choice", "q": "They ___ got a car.", "de": "Sie haben kein Auto.", "options": ["haven't", "hasn't", "aren't", "don't"], "answer": "haven't", "explain": "they → have → verneint **haven't** got (= have not got)." },
    { "type": "choice", "q": "___ you got a ruler?", "options": ["Have", "Has", "Are", "Do"], "answer": "Have", "explain": "Frage mit you: **Have** kommt nach vorn – Have you got …?" },
    { "type": "choice", "q": "___ she got a pet?", "options": ["Has", "Have", "Is", "Does"], "answer": "Has", "explain": "Frage mit she: **Has** kommt nach vorn – Has she got …?" },
    { "type": "choice", "q": "Have you got a pen? – Yes, I ___.", "options": ["have", "has", "am", "got"], "answer": "have", "explain": "Kurze Antwort ohne got: Have you got …? – Yes, I **have**." },
    { "type": "choice", "q": "Has he got a brother? – No, he ___.", "options": ["hasn't", "haven't", "isn't", "doesn't"], "answer": "hasn't", "explain": "Kurzantwort ohne got: **No, he hasn't.**" },
    { "type": "input", "q": "My mum ___ got a red car.", "answer": "has", "hint": "have / has", "explain": "My mum = she → **has** got." },
    { "type": "input", "q": "You ___ got nice shoes.", "answer": "have", "hint": "have / has", "explain": "you → **have** got." },
    { "type": "input", "q": "It ___ got four legs.", "answer": "has", "hint": "have / has", "explain": "it → **has** got." },
    { "type": "input", "q": "I ___ got a dog. I've got a cat.", "answer": "haven't", "hint": "Verneinung, Kurzform", "explain": "I → have → verneint **haven't** got." },
    { "type": "order", "de": "Ich habe zwei Schwestern.", "answer": "I have got two sisters.", "accept": ["I've got two sisters."], "explain": "I + **have got** + two sisters. Das got gehört direkt hinter have." },
    { "type": "order", "de": "Hast du ein Haustier?", "answer": "Have you got a pet?", "explain": "Frage: **Have** kommt nach vorn, got bleibt hinter you – Have you got a pet?" },
    { "type": "order", "de": "Sie hat blaue Augen.", "answer": "She has got blue eyes.", "accept": ["She's got blue eyes."], "explain": "she → **has got** + blue eyes." }
  ]
}
