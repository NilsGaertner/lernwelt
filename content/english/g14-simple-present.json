  "title": "I play – he plays",
  "subtitle": "Simple Present",
  "icon": "🔁",
  "explain": [
    { "p": "Das **Simple Present** benutzt du für Dinge, die **immer wieder** oder **regelmäßig** passieren: jeden Tag, oft, am Montag …" },
    { "p": "Das Verb bleibt fast immer gleich. **Nur bei he, she, it** hängst du ein **-s** an!" },
    { "table": { "head": ["Wer?", "Verb"], "rows": [
      ["I / you / we / they", "play"],
      ["he / she / it", "play**s**"]
    ] } },
    { "tip": "Merksatz: **He, she, it – das -s muss mit!**" },
    { "table": { "head": ["Verb endet auf …", "he / she / it", "Beispiel"], "rows": [
      ["-s, -sh, -ch, -x, -o", "**-es**", "watch → watch**es**, go → go**es**, do → do**es**"],
      ["Konsonant + y", "**-ies**", "fly → fl**ies**, cry → cr**ies**"],
      ["Vokal + y", "nur **-s**", "play → play**s**"],
      ["have", "**has**", "she **has** breakfast"]
    ] } }
  ],
  "exercises": [
    { "type": "choice", "q": "She ___ football every day.", "options": ["plays", "play", "playes", "playing"], "answer": "plays", "explain": "she → Verb + **s**." },
    { "type": "choice", "q": "I ___ my bike to school.", "options": ["ride", "rides", "rided", "riding"], "answer": "ride", "explain": "Bei I kein -s." },
    { "type": "choice", "q": "My dad ___ in an office.", "options": ["works", "work", "workes", "working"], "answer": "works", "explain": "My dad = he → **works**." },
    { "type": "choice", "q": "We ___ English on Mondays.", "options": ["have", "has", "haves", "having"], "answer": "have" },
    { "type": "choice", "q": "Tom ___ TV after school.", "options": ["watches", "watchs", "watch", "watchies"], "answer": "watches", "explain": "watch endet auf -ch → **-es**." },
    { "type": "choice", "q": "My sister ___ to school by bus.", "options": ["goes", "gos", "go", "goies"], "answer": "goes", "explain": "go → **goes** (mit -es)." },
    { "type": "choice", "q": "The baby ___ a lot.", "options": ["cries", "crys", "cry", "cryes"], "answer": "cries", "explain": "Konsonant + y → **-ies**." },
    { "type": "choice", "q": "They ___ in London.", "options": ["live", "lives", "livs", "living"], "answer": "live" },
    { "type": "choice", "q": "Lisa ___ a cat.", "options": ["has", "haves", "have", "hass"], "answer": "has", "explain": "have → bei he/she/it: **has**." },
