  "explain": [
    { "p": "Für Fragen im Simple Present brauchst du **Do** oder **Does** am Anfang." },
    { "table": { "head": ["Wer?", "Frage", "Kurzantwort"], "rows": [
      ["I / you / we / they", "**Do** you like pizza?", "Yes, I **do**. / No, I **don't**."],
      ["he / she / it", "**Does** she like pizza?", "Yes, she **does**. / No, she **doesn't**."]
    ] } },
    { "tip": "Wie bei der Verneinung: Das -s steckt schon in **Does**. Das Verb bleibt ohne -s: Does he play**s** ✗ → Does he **play** ✓" },
    { "p": "Mit Fragewort: **Where do** you live? — **What does** she like?" },
    { "p": "Bei **am/is/are**, **can** und **have got** brauchst du kein do: Are you …? Can you …? Have you got …?" }
  ],
  "exercises": [
    { "type": "choice", "q": "___ you like chocolate?", "options": ["Do", "Does", "Are", "Is"], "answer": "Do", "explain": "Frage mit you → **Do** you …?" },
