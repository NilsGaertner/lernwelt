    { "type": "choice", "q": "Does Tom play the guitar? – No, he ___.", "options": ["doesn't", "don't", "isn't", "not"], "answer": "doesn't", "explain": "Kurze Antwort: Does Tom …? – No, he **doesn't**." },
    { "type": "choice", "q": "Where ___ you live?", "options": ["do", "does", "are", "is"], "answer": "do", "explain": "Fragewort + **do** + you: Where **do** you live?" },
